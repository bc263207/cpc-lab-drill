{
  "_about": [
    "Numeric transcription of data/lab-master-table.json for the Arm A generator and the pre-deploy validator.",
    "The master table governs. This file only turns its prose ranges into machine-checkable intervals; if the two disagree, fix this file.",
    "Each lab has one or more 'sets' (one per unit system or per context, e.g. INR off vs on warfarin, hemoglobin male vs female).",
    "Per set: units (validation name), suffix (what is rendered after the number), decimals, plausible (hard generation bounds),",
    "normal (band 0), bands (level 1-3 from the table, plus optional named bands), exclude (safety margins: no generated value may fall here).",
    "Exclusion zones sit around every reference-range cutoff so that no item ever uses a value that one laboratory would flag and another would not.",
    "Sets with no 'normal' cannot be used for normal-vs-abnormal classification (amylase/lipase, osmolality, vancomycin, ionized calcium bands).",
    "Creatinine is 'relative': its level 1-3 bands are ratios of today's value to the stated baseline, exactly as the table defines them."
  ],
  "baselineRequired": ["Creatinine", "Hemoglobin", "BNP", "Troponin"],
  "noItems": {
    "Chloride": "Table: included for anion gap only; do not build standalone classification items."
  },
  "labs": {
    "Glucose": {
      "sets": {
        "mg/dL": {
          "units": "mg/dL", "suffix": "mg/dL", "decimals": 0, "plausible": [20, 900],
          "normal": [70, 100],
          "bands": { "1": [[50, 69], [180, 249]], "2": [[40, 49], [250, 399]], "3": [[20, 39], [401, 900]] },
          "exclude": [[65, 75], [96, 179]],
          "note": "Fasting range. 101-179 is excluded entirely because the post-prandial limit (140) makes it ambiguous without timing."
        },
        "mmol/L": {
          "units": "mmol/L", "suffix": "mmol/L", "decimals": 1, "plausible": [1.0, 50.0],
          "normal": [3.9, 5.6],
          "bands": { "1": [[2.8, 3.8], [10.0, 13.8]], "2": [[2.2, 2.7], [13.9, 22.2]], "3": [[1.0, 2.1], [22.3, 50.0]] },
          "exclude": [[3.6, 4.2], [5.3, 9.9]],
          "note": "mg/dL divided by 18."
        }
      }
    },
    "Sodium": {
      "sets": {
        "default": {
          "units": "mEq/L", "suffix": "mEq/L", "decimals": 0, "plausible": [105, 175],
          "normal": [136, 142],
          "bands": { "1": [[130, 134], [146, 149]], "2": [[125, 129], [150, 155]], "3": [[105, 119], [161, 175]] },
          "exclude": [[133, 135], [143, 146]],
          "note": "Textbook range is narrower than most laboratories (135-145), so the margins are wide: 133-135 and 143-146 are never used."
        }
      }
    },
    "Potassium": {
